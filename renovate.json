{
    "extends": ["config:recommended"],
    "packageRules": [
        {
            "automerge": true,
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ]
        },
        {
            "matchDepNames": ["postcss-selector-parser"],
            "description": "Pinned via a pnpm override for GHSA-rj75-hqrm-r3gf; @tailwindcss/typography needs 6.x",
            "allowedVersions": "<7"
        },
        {
            "matchDepNames": ["java"],
            "description": "LTS builds only (CI uses Java 25), and skip Adoptium's bogus 25.0.5+100000002.0.LTS entry by capping build numbers at 5 digits",
            "matchManagers": ["asdf"],
            "allowedVersions": "/^\\d+\\.\\d+\\.\\d+\\+\\d{1,5}\\.\\d+\\.LTS$/"
        },
        {
            "matchDepNames": ["pnpm"],
            "matchManagers": ["asdf"],
            "automerge": false
        }
    ]
}
